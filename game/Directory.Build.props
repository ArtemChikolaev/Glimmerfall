<Project>
  <!-- Останавливает подъём к корневому Directory.Build.props: game/ собирает Godot.NET.Sdk со своими путями вывода. -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- iOS (NativeAOT): предупреждения AOT/тримминга идут из самого GodotSharp — ошибками их делать нельзя, иначе ILC падает. -->
    <IlcTreatWarningsAsErrors>false</IlcTreatWarningsAsErrors>
    <ILLinkTreatWarningsAsErrors>false</ILLinkTreatWarningsAsErrors>
  </PropertyGroup>
</Project>
