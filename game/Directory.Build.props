<Project>
  <!-- Останавливает подъём к корневому Directory.Build.props: game/ собирает Godot.NET.Sdk со своими путями вывода. -->
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>
