<Project Sdk="Microsoft.NET.Sdk">
  <!-- Headless-харнесс (ADR 0002): бенч тиков, бот-прогоны и карьера, запись и проверка реплеев, дайджесты для матрицы CI. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Glimmerfall.Sim.Cli</RootNamespace>
    <AssemblyName>glimmerfall-sim</AssemblyName>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../sim/Glimmerfall.Sim.csproj" />
  </ItemGroup>
</Project>
